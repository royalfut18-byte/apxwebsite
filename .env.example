# Copy to .env.local for local development, or set these in your host's dashboard.
# All optional. Without RESEND_API_KEY the contact form opens the visitor's mail app instead.

# Resend API key. Turns on in-page delivery of contact form enquiries.
RESEND_API_KEY=

# Where enquiries are sent. Defaults to the email in src/lib/site.ts.
CONTACT_TO_EMAIL=

# The sender, e.g. "APX Website <website@apx.com.au>". Must be on a domain verified with Resend.
CONTACT_FROM_EMAIL=
