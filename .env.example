# Copy to .env.local for local development, or set these in your host's dashboard.
# All optional. With none of them set, the contact form opens the visitor's mail app instead.

# Where each lead is posted: for example the APECS main chat's webhook address. Treat it like
# a password (anyone with it can post there): keep it in the host's settings, not in the code.
LEADS_WEBHOOK_URL=

# Optional key for platforms that ask for one. Sent as "Authorization: Bearer <secret>".
LEADS_WEBHOOK_SECRET=

# Optional: discord, slack, google-chat or json. Worked out from the address when left out.
LEADS_WEBHOOK_FORMAT=

# Resend API key. Turns on email delivery of contact form enquiries.
RESEND_API_KEY=

# Where enquiry emails are sent. Defaults to the email in src/lib/site.ts.
CONTACT_TO_EMAIL=

# The sender, e.g. "APXS Website <website@apxs.com.au>". Must be on a domain verified with Resend.
CONTACT_FROM_EMAIL=

# Booking calls on /book. Nothing to set for APXS: bookings go to APECS (the address next to
# LEADS_WEBHOOK_URL, …/api/calls/website) with LEADS_WEBHOOK_SECRET. Set these only to send
# them somewhere else. Without either, /book offers email instead.
BOOKING_API_URL=
BOOKING_API_SECRET=
